# Copy to .env (cp .env.example .env); `make run` loads it.
# Required keys must be set. Optional keys use the default shown when unset or empty.

# Required. host:port to listen on. Use 0.0.0.0:7890 in a container.
KV_LISTEN_ADDR=127.0.0.1:7890

# Required. Append-only request log file, or - for stdout (use - in a container).
KV_LOG_PATH=./in/kv.log

# Required. SQLite database file for the persistence layer.
KV_DB_PATH=./in/kv.db

# Optional. Ms between database commits = max data lost on crash or power loss. 1-3600000. Default 100.
KV_FLUSH_INTERVAL_MS=100

# Optional. Changes that may wait for the database (disk full, DB locked) before POST/DELETE
# return 503. 1-1000000000. Default 1000000.
KV_MAX_PENDING=

# Optional. Event-loop threads, 0-1024. Empty or 0 = one per usable CPU.
KV_THREADS=

# Optional. 1 = POST/DELETE respond only after the change is committed to the database. Default 0.
KV_SYNC_ACK=

# Optional. Seconds a delete marker stays before it is purged, 1-31536000. Default 3600.
KV_TOMBSTONE_TTL_S=
