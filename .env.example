# Copy to .env (cp .env.example .env); `make run` loads it.
# Required keys must be set. Optional keys use the default shown when unset or empty.

# Required. host:port to listen on. Use 0.0.0.0:7890 in a container.
KV_LISTEN_ADDR=127.0.0.1:7890

# Required. Append-only request log file, or - for stdout (use - in a container).
KV_LOG_PATH=./in/kv.log

# Required. SQLite database file for the persistence layer.
KV_DB_PATH=./in/kv.db

# Optional. Snapshot file the store loads at start and rewrites when dirty.
KV_SNAPSHOT_PATH=kv_snapshot_persistence.txt

# Optional. Flush interval in ms, 1-3600000. Default 100.
KV_FLUSH_INTERVAL_MS=100

# Optional. Event-loop threads, 0-1024. Empty or 0 = one per usable CPU.
KV_THREADS=
