# Control plane (cp) settings. Required keys must be set; optional keys use the default shown.

# Required. host:port cp listens on for clients and admin.
KV_CP_LISTEN_ADDR=127.0.0.1:7890
# Required. SQLite file for cp state (nodes, migration, version mark).
KV_CP_DB_PATH=./in/cp.db
# Required. Request log file, or - for stdout.
KV_CP_LOG_PATH=./in/cp.log

# Optional. Event-loop threads, 0-1024. Empty or 0 = one per usable CPU.
KV_CP_THREADS=
# Optional. Storage nodes at start, 1-1024. Default 1.
KV_CP_INITIAL_NODES=
# Optional. Lowest node count, 1-1024. Default = KV_CP_INITIAL_NODES. Not used yet (no scale-down).
KV_CP_MIN_NODES=
# Optional. Highest node count, 1-1024, >= KV_CP_INITIAL_NODES. Default 3.
KV_CP_MAX_NODES=
# Optional. Replicas per key, 1-1024, <= KV_CP_INITIAL_NODES. Default 1.
KV_CP_REPLICAS=
# Optional. Ring points per node, 1-4096. Default 128.
KV_CP_VNODES=
# Optional. Per-node RPS over the window that adds a node. Empty or 0 = autoscale off.
KV_CP_SCALE_RPS=
# Optional. RPS window in s, 1-3600. Default 10.
KV_CP_SCALE_WINDOW_S=
# Optional. Min s between scale events, 0-86400. Default 60.
KV_CP_SCALE_COOLDOWN_S=
# Optional. Ms between health probes, 10-600000. Default 1000.
KV_CP_PROBE_INTERVAL_MS=
# Optional. Failed probes in a row before a node is DEAD, 1-1000. Default 3.
KV_CP_PROBE_FAILS=
# Optional. Ms before a forward to a node fails, 1-600000. Default 2000.
KV_CP_FORWARD_TIMEOUT_MS=
# Optional. Docker image of a storage node. Default kv-storage.
KV_CP_NODE_IMAGE=
# Optional. Process driver (tests): node i listens on 127.0.0.1:(base + i). Default 7900.
KV_CP_NODE_BASE_PORT=
